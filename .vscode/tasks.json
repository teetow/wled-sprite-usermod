{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FX: Build",
			"type": "shell",
			"command": "./build-local.sh",
			"args": [
				"${workspaceFolder}/../wled-sprite-build",
				"esp32dev"
			],
			"problemMatcher": [],
			"detail": "Build firmware only, no deploy"
		},
		{
			"label": "FX: Deploy",
			"type": "shell",
			"command": "./build-local.sh",
			"args": [
				"${workspaceFolder}/../wled-sprite-build",
				"esp32dev",
				"--skip-build",
				"--deploy-host",
				"wled-32.local"
			],
			"problemMatcher": [],
			"detail": "Deploy the most recently built firmware without rebuilding"
		},
		{
			"label": "FX: Build and Deploy",
			"type": "shell",
			"command": "./build-local.sh",
			"args": [
				"${workspaceFolder}/../wled-sprite-build",
				"esp32dev",
				"--deploy-host",
				"wled-32.local"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "Build firmware and deploy it to wled-32.local"
		}
	]
}
