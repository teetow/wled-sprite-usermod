+// Global brightness with one rounding per channel. WLED's video fade ORs the
+// low bit into every channel above a quarter of the brightest one: at the low
+// brightness the room scenes use, muted darks turn neutral gray and only odd
+// codes remain. The current limiter's second pass keeps the video fade.
+static inline uint32_t IRAM_ATTR roundedFade(uint32_t c, uint8_t amount) {
+  if (amount == 255) return c;
+  const uint32_t TWO_CHANNEL_MASK = 0x00FF00FF;
+  uint32_t rb = ((((c & TWO_CHANNEL_MASK) * amount) + 0x007F007F) >> 8) & TWO_CHANNEL_MASK;
+  uint32_t wg = ((((c >> 8) & TWO_CHANNEL_MASK) * amount) + 0x007F007F) & ~TWO_CHANNEL_MASK;
+  return rb | wg;
+}
